# ──────────────────────────────────────────────────────────────
# Oil Trading Desk — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# The backend starts without these but uses synthetic/fallback data.
# ──────────────────────────────────────────────────────────────

# EIA v2 API — free registration: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Twelve Data — free registration: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# ── Optional (Phase 2) ──────────────────────────────────────
# AIS_API_KEY=your_ais_api_key_here
# HF_TOKEN=your_huggingface_token_here
# PAPER_STATE_REPO=your_hf_dataset_repo
